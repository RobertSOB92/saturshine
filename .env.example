# === Klucze PUBLICZNE (eksponowane w kliencie przeglądarki) ===
# Bezpieczne do umieszczenia w kodzie po stronie klienta — chronione przez RLS Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Publiczny klucz VAPID — używany w przeglądarce do rejestracji subskrypcji Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# === Klucze PRYWATNE (wyłącznie server-side) ===
# NIGDY nie dodawaj prefiksu NEXT_PUBLIC_ do poniższych zmiennych!
# NIGDY nie importuj ich w komponentach klienta ani hooks po stronie klienta!

# Klucz Service Role Supabase — omija RLS, używany wyłącznie w API Routes / Server Actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Prywatny klucz VAPID — używany do podpisywania powiadomień push (biblioteka web-push)
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# Adres e-mail dla identyfikacji VAPID (wymagany przez Web Push protokół)
VAPID_EMAIL=mailto:admin@saturshine.pl
